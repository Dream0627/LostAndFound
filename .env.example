# docker compose 自动读取同目录 .env；本文件是模板，复制为 .env 后改成真实值。
# .env 已在 .gitignore 中，切勿提交真实口令。
#
# 注意：
#   - MYSQL_PASSWORD 必须与 config/config.docker.yaml 的 database.password 保持一致；
#   - 若 MySQL 数据卷已初始化过，修改口令不会自动生效（MySQL 仅在首次建库时读取），
#     需要进库手动改密，或与既有口令保持一致；
#   - 生产环境请使用强随机口令，例如：openssl rand -hex 16

MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=laf_db
MYSQL_USER=laf

# 临时前端的 HTTPS 站点地址：填服务器"公网 IP"（如 47.96.1.2），
# Caddy 用它签发自签名证书，浏览器提示"不安全"后点继续访问即可。
# 占位符不要提交真实 IP。
SITE_ADDRESS=your.server.public.ip
